{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "CI_REQUIRE_DB",
        "WORKER_DATABASE_URL",
        "SILO_TRASH_PURGE_DAYS",
        "SILO_ENRICHING_STALE_MINUTES",
        "SILO_API_TOKEN",
        "SILO_APP_PASSWORD",
        "SILO_SESSION_SECRET"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "CI_REQUIRE_DB",
        "WORKER_DATABASE_URL",
        "SILO_TRASH_PURGE_DAYS",
        "SILO_ENRICHING_STALE_MINUTES",
        "SILO_API_TOKEN",
        "SILO_APP_PASSWORD",
        "SILO_SESSION_SECRET"
      ]
    }
  }
}
