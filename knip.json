{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["docs/**", "packages/web/src/dev/agentation-stub.ts"],
  "ignoreWorkspaces": ["packages/tsconfig"],
  "workspaces": {
    "packages/db": {
      "drizzle": true,
      "ignoreBinaries": ["psql"]
    },
    "packages/cli": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"],
      "ignoreBinaries": ["tsx", "tsc", "vitest"]
    }
  }
}
