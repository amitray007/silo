{
  "name": "silo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "predev": "pnpm db:migrate || echo '[silo] db:migrate skipped (is Postgres up? run pnpm db:up) — starting dev anyway'",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test --concurrency=1",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "dupes": "jscpd",
    "deadcode": "knip",
    "quality": "pnpm lint && pnpm boundaries && pnpm dupes && pnpm deadcode",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @silo/db run db:migrate",
    "start": "pnpm --filter @silo/app run start",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "turbo": "2.10.5"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.10": "2.0.11",
      "brace-expansion@<5.0.9": "5.0.9",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "fast-uri@<3.1.5": "3.1.5",
      "hono@<4.12.34": "4.12.34",
      "ip-address@<10.3.1": "10.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "re2@<1.26.1": "1.26.1",
      "tar@7.5.19": "7.5.22",
      "undici@<8.0.0": "7.29.0",
      "undici@>=8.0.0 <8.9.0": "8.9.0"
    }
  }
}
