{
  "name": "silo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "predev": "pnpm db:migrate || echo '[silo] db:migrate skipped (is Postgres up? run pnpm db:up) — starting dev anyway'",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test --concurrency=1",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "dupes": "jscpd",
    "deadcode": "knip",
    "quality": "pnpm lint && pnpm boundaries && pnpm dupes && pnpm deadcode",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @silo/db run db:migrate",
    "start": "pnpm --filter @silo/app run start",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "turbo": "2.10.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1"
    }
  }
}
