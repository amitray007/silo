{
  "name": "silo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "predev": "pnpm db:migrate || echo '[silo] db:migrate skipped (is Postgres up? run pnpm db:up) \u2014 starting dev anyway'",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test --concurrency=1",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "dupes": "jscpd",
    "deadcode": "knip",
    "quality": "pnpm lint && pnpm boundaries && pnpm dupes && pnpm deadcode",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @silo/db run db:migrate",
    "start": "pnpm --filter @silo/app run start",
    "prepare": "lefthook install",
    "test:view-sandbox": "node scripts/test-view-sandbox.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "playwright": "1.64.1",
    "turbo": "2.11.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.1.3": "2.1.3",
      "brace-expansion@<5.0.12": "5.0.12",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "fast-uri@<3.1.8": "3.1.8",
      "hono@<4.13.11": "4.13.11",
      "ip-address@<10.7.4": "10.7.4",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "re2@<1.26.1": "1.26.1",
      "sharp@<0.35.5": "0.35.5",
      "smol-toml@<1.9.0": "1.9.0",
      "source-map-js@<1.2.2": "1.2.2",
      "tar@7.5.19": "7.5.22",
      "undici@<7.29.1": "7.29.1",
      "undici@>=8.0.0 <8.10.2": "8.11.2"
    }
  }
}
