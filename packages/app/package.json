{
  "name": "@silo/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "silo": "./src/main.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "start:mcp-http": "tsx --env-file-if-exists=../../.env src/mcp-http-main.ts",
    "start:api": "tsx --env-file-if-exists=../../.env src/api-main.ts",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@silo/api": "workspace:*",
    "@silo/core": "workspace:*",
    "@silo/mcp-server": "workspace:*",
    "@silo/worker": "workspace:*"
  },
  "devDependencies": {
    "@silo/db": "workspace:*",
    "@silo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
