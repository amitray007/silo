{
  "threshold": 1.5,
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["console"],
  "absolute": true,
  "gitignore": true,
  "pattern": "packages/**/src/**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/docs/**",
    "**/test-support/**",
    "**/*.test.{ts,tsx}",
    "packages/cli/src/types.ts",
    "packages/cli/src/client.ts",
    "packages/cli/src/buckets.ts"
  ]
}
